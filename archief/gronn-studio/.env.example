# Real values live in .env.local (git-ignored) and in the Vercel
# project's environment variables. Never commit real values.

# GRØNN Editor — content document on Vercel Blob (E1/E3)
CONTENT_BLOB_URL=
BLOB_READ_WRITE_TOKEN=

# GRØNN Editor — Google sign-in (E2)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3105
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EDITOR_ALLOWED_EMAIL=hello@gronn.studio

# GRØNN client portal — Supabase (client dossier, accounts, RLS)
# The service-role key bypasses every row-level policy, so it is
# server-only and must never appear in a NEXT_PUBLIC_ variable.
# Absent values are not an error: the panel renders a signed-out state
# and CI builds without a database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
